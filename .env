# https://github.com/blockscout/frontend/blob/main/docs/ENVS.md
# App configuration
NEXT_PUBLIC_APP_HOST=dolphin-scan.over.network
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_PORT=443
NEXT_PUBLIC_APP_ENV=production

# Blockchain parameters
NEXT_PUBLIC_NETWORK_NAME=Over Dophin Devnet 1
NEXT_PUBLIC_NETWORK_SHORT_NAME=Over dolphin-devnet-1
NEXT_PUBLIC_NETWORK_RPC_URL=https://wallet-dolphin.rpc.over.network
NEXT_PUBLIC_NETWORK_ID=541764
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Over
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=OVER
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_IS_TESTNET=true

# API configuration
NEXT_PUBLIC_API_HOST=dolphin-scan.over.network
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_PORT=443
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# UI configuration
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_NETWORK_LOGO=https://asset.over.network/over-scan/light_120.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://asset.over.network/over-scan/dark_120.svg
NEXT_PUBLIC_NETWORK_ICON=https://asset.over.network/over-scan/light_22.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=https://asset.over.network/over-scan/dark_22.svg
FAVICON_MASTER_URL=https://asset.over.network/over-scan/favicon.svg

# Views
NEXT_PUBLIC_VIEWS_BLOCK_HIDDEN_FIELDS=['burnt_fees']
NEXT_PUBLIC_VIEWS_TX_HIDDEN_FIELDS=['burnt_fees']
NEXT_PUBLIC_NAVIGATION_HIDDEN_LINKS=['eth_rpc_api','rpc_api']

# Blockchain interaction (writing to contract, etc.)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=93c3514e9da67ac1c804d3df8c9a8ee4

# Banner ads
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# Beacon chain
NEXT_PUBLIC_HAS_BEACON_CHAIN=true
NEXT_PUBLIC_BEACON_CHAIN_CURRENCY_SYMBOL=OVER

# Blockchain statistics
NEXT_PUBLIC_STATS_API_HOST=https://dolphin-scan.over.network/
NEXT_PUBLIC_STATS_API_BASE_PATH=/statistics

# Solidity to UML diagrams
NEXT_PUBLIC_VISUALIZE_API_HOST=https://dolphin-scan.over.network/
NEXT_PUBLIC_VISUALIZE_API_BASE_PATH=/visualizer

# Web3 wallet integration (add token or network to the wallet)
NEXT_PUBLIC_WEB3_WALLETS=[]

# GraphQL API documentation
NEXT_PUBLIC_GRAPHIQL_TRANSACTION=none

# REST API documentation
NEXT_PUBLIC_API_SPEC_URL=none
